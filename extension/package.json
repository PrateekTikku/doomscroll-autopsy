{
  "name": "doomscroll-autopsy",
  "description": "Protect your deep work from the feed.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && node scripts/copy-model.mjs && wxt",
    "build": "node scripts/copy-ort.mjs && node scripts/copy-model.mjs && wxt build",
    "zip": "node scripts/copy-ort.mjs && node scripts/copy-model.mjs && node scripts/zip-release.mjs",
    "probe:m7": "node scripts/m7-probe.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "node scripts/gen-types.ts",
    "postinstall": "wxt prepare",
    "smoke": "node scripts/smoke-chrome.mjs",
    "check:types": "npm run gen:types && git diff --exit-code ../shared/types.ts",
    "live": "node scripts/copy-ort.mjs && node scripts/copy-model.mjs && wxt build && node scripts/live.mjs",
    "probe:s1": "node scripts/s1-probe.mjs",
    "build:spike": "node scripts/copy-ort.mjs && SPIKE=1 wxt build",
    "probe:s2": "node scripts/s2-probe.mjs",
    "eval:m4": "M4_EVAL=1 vitest run lib/replay/synthetic-eval.test.ts",
    "probe:m4": "node scripts/m4-probe.mjs",
    "eval:m5": "M5_EVAL=1 vitest run lib/metrics/replayed.test.ts",
    "probe:m5": "node scripts/m5-probe.mjs",
    "eval:m6": "M6_EVAL=1 vitest run lib/gen/evidence.test.ts",
    "probe:m6": "node scripts/m6-probe.mjs",
    "report:m6": "M6_REPORT=1 vitest run lib/gen/evidence.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "idb": "^8.0.4",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
