{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doomscroll-autopsy:schema:territory-description:v1",
  "title": "TerritoryDescription",
  "description": "Input to territory naming and label suggestion (PDD 9.4). Text only; built from stored metadata.",
  "type": "object",
  "properties": {
    "origins": {
      "description": "Top origins and path prefixes by sample count, most frequent first.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "title": "TerritoryOrigin",
        "type": "object",
        "properties": {
          "origin": { "type": "string", "pattern": "^https?://[^/?#]+$" },
          "pathPrefix": { "type": "string", "pattern": "^/[^?#]*$" },
          "count": { "type": "integer", "minimum": 1 }
        },
        "required": ["origin", "pathPrefix", "count"],
        "additionalProperties": false
      }
    },
    "sampleTitles": {
      "description": "Up to 5 page or item titles; empty when \"store titles\" is off.",
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "topicTags": {
      "description": "Top zero-shot topic tags with cosine similarity (PDD 9.3); empty when unavailable.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "title": "TopicTag",
        "type": "object",
        "properties": {
          "tag": { "type": "string", "minLength": 1, "maxLength": 60 },
          "score": { "type": "number", "minimum": -1, "maximum": 1 }
        },
        "required": ["tag", "score"],
        "additionalProperties": false
      }
    },
    "velocity": {
      "title": "VelocityProfile",
      "type": "object",
      "properties": {
        "itemsPerMin": { "type": "number", "minimum": 0 },
        "skipRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanDwellS": { "type": "number", "minimum": 0 }
      },
      "required": ["itemsPerMin", "skipRate", "meanDwellS"],
      "additionalProperties": false
    },
    "minutesToday": { "type": "integer", "minimum": 0 }
  },
  "required": ["origins", "sampleTitles", "topicTags", "velocity", "minutesToday"],
  "additionalProperties": false
}
